DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="https://voltrauz.vercel.app"

# Optional — password-reset emails are only sent when all three are set.
# Without them, the reset link is logged to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
